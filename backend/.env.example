# Copy to .env for local development: cp .env.example .env
# JWT_SECRET is required when NODE_ENV=production.
JWT_SECRET="dev-secret-change-in-production"
PORT=4000
# SQLite file path (defaults to ../dev.db). Use ":memory:" for a throwaway DB.
# DATABASE_FILE=./dev.db
# Where uploaded logos are stored (defaults to ./uploads).
# UPLOAD_DIR=./uploads
