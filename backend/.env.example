# Copy to .env and fill in. Never commit .env.
PORT=4000
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Optional: SQLite file path (defaults to backend/dev.db)
# DATABASE_FILE=./dev.db
# Optional: where uploaded logos are stored (defaults to backend/uploads)
# UPLOAD_DIR=./uploads

# --- Phase 2: AI bill reading ---
# Add ONE of these keys. Without a key the app still works: bills open for
# manual entry instead of being read automatically.
# OPENAI_API_KEY=sk-...            (platform.openai.com)
# ANTHROPIC_API_KEY=sk-ant-...     (console.anthropic.com)
# If both are set, Claude is used unless you add EXTRACTION_PROVIDER=openai
# Optional: model used to read bills. Leave it out with OpenAI and the app
# picks the best vision model your key can use (check with: npm run check-ai).
# Claude default: claude-sonnet-5-5
# EXTRACTION_MODEL=
# Optional: EXTRACTION_PROVIDER=mock returns a fixed sample reading, for demos

# --- Phase 4: invoice PDFs ---
# Word files are always made. PDFs of builder templates are made by the
# built-in renderer; for exact PDFs of every template (including uploaded
# Word templates) install LibreOffice (free, libreoffice.org). It is found
# automatically in C:\Program Files\LibreOffice; otherwise set its path:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# PDF_ENGINE=auto   (auto | libreoffice | builtin | off)
