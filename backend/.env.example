# Copy to .env for local development: cp .env.example .env
# JWT_SECRET is required when NODE_ENV=production.
JWT_SECRET="dev-secret-change-in-production"
PORT=4000
# SQLite file path (defaults to ../dev.db). Use ":memory:" for a throwaway DB.
# DATABASE_FILE=./dev.db
# Where uploaded logos are stored (defaults to ./uploads).
# UPLOAD_DIR=./uploads
# Claude API key for AI bill extraction (Phase 2). Without it, bills upload
# fine but extraction fails with "isn't configured on the server".
ANTHROPIC_API_KEY=
# Optional tuning; see src/extraction/claudeExtractor.js.
# EXTRACTION_MODEL=claude-opus-5
# EXTRACTION_EFFORT=medium
