# Copy to .env and fill in. Never commit .env.
PORT=4000
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Optional: SQLite file path (defaults to backend/dev.db)
# DATABASE_FILE=./dev.db
# Optional: where uploaded logos are stored (defaults to backend/uploads)
# UPLOAD_DIR=./uploads

# --- Phase 2: AI bill reading ---
# Anthropic API key (console.anthropic.com). Without it the app still works:
# bills open for manual entry instead of being read automatically.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: model used to read bills (default claude-sonnet-5-5)
# EXTRACTION_MODEL=claude-sonnet-5-5
# Optional: EXTRACTION_PROVIDER=mock returns a fixed sample reading, for demos
