# Copy to .env and fill in. Never commit .env.
PORT=4000
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Optional: SQLite file path (defaults to backend/dev.db)
# DATABASE_FILE=./dev.db
# Optional: where uploaded logos are stored (defaults to backend/uploads)
# UPLOAD_DIR=./uploads
